# Обязательно смените на случайную строку (32+ символа)
SECRET_KEY=change-me-in-production-please

# PostgreSQL (совпадает с настройками сервиса db в docker-compose.yml)
DATABASE_URL=postgresql://webook:webook@db:5432/webook
DB_PASSWORD=webook

# Заголовок приложения
APP_TITLE=WeBook

# Логирование (файлы в ./logs с ротацией)
# LOG_LEVEL=INFO
# LOGS_DIR=./logs

# Порт прямого HTTP-доступа к приложению (по умолчанию 8000)
# APP_PORT=8000

# ── HTTPS / Caddy ───────────────────────────────────────────────────────────
# Адрес сайта для Caddy. По умолчанию — localhost (доступ на самой машине).
# Для доступа по локальному IP укажите IP вашего сервера (самоподписанный
# сертификат). Для публичного домена укажите имя хоста — Caddy получит
# доверенный сертификат Let's Encrypt.
# SITE_ADDRESS=192.168.1.50
# ACME_EMAIL=you@example.com

# ── Администратор при первой установке (необязательно) ───────────────────────
# Если заданы и в базе ещё нет пользователей — создаётся администратор с этими
# данными при первом запуске. Если не заданы — первый зарегистрировавшийся
# пользователь автоматически становится администратором.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
