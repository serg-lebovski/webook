{
  "manifest_version": 3,
  "name": "WeBook",
  "version": "1.0.0",
  "description": "Сохраняйте ссылки на статьи в свою библиотеку WeBook",
  "permissions": ["activeTab", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "WeBook"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "webook@extension",
      "strict_min_version": "109.0"
    }
  }
}
