# WeBook reverse proxy + HTTPS
#
# По умолчанию SITE_ADDRESS = localhost (доступ на самой машине).
# Для доступа по локальному IP (домашний сервер) задайте в .env:
#   SITE_ADDRESS=192.168.1.50      # IP вашего сервера
# Caddy автоматически выпустит собственный сертификат (локальный CA,
# «tls internal») — трафик шифруется, браузер один раз попросит подтвердить
# доверие. Это нормально для локальной сети.
#
# Если появится публичный домен — задайте в .env:
#   SITE_ADDRESS=webook.example.com
#   ACME_EMAIL=you@example.com
# тогда Caddy сам получит доверенный сертификат Let's Encrypt (нужен
# публичный доступ к серверу на портах 80 и 443) и удалите `tls internal` ниже.

{
	email {$ACME_EMAIL:admin@example.com}
	# При доступе по IP клиент не отправляет SNI — указываем сертификат
	# по умолчанию, иначе TLS-рукопожатие падает с internal error.
	default_sni {$SITE_ADDRESS:localhost}
}

{$SITE_ADDRESS:localhost} {
	encode gzip
	# Самоподписанный сертификат (локальный CA) для доступа по IP.
	# Он же создаёт connection policy, к которой привязывается default_sni.
	# ДЛЯ ПУБЛИЧНОГО ДОМЕНА удалите строку `tls internal` ниже — тогда Caddy
	# автоматически получит доверенный сертификат Let's Encrypt.
	tls internal
	reverse_proxy app:8000
}
